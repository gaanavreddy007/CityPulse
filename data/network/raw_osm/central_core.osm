 <relation id="14612088" visible="true" version="1" changeset="126525044" timestamp="2022-09-23T00:05:16Z" user="AlwynWellington" uid="567640">
  <member type="relation" ref="8489336" role=""/>
  <member type="relation" ref="8496757" role=""/>
  <tag k="description" v="Inspired by Ninian, 4th century saint, miracle worker, and possibly the first missionary to Scotland.  From Glasgow Cathedral, Paisley’s abbey, the coast, over hill, through famous Scottish towns to Ninian’s pilgrim welcoming chapel."/>
  <tag k="from" v="S Mungo's, Glasgow"/>
  <tag k="name" v="Whithorn Way"/>
  <tag k="network" v="rwn"/>
  <tag k="network:type" v="rwn"/>
  <tag k="ref" v="WW"/>
  <tag k="route" v="hiking"/>
  <tag k="source" v="https://www.whithorn.com/about-us/"/>
  <tag k="to" v="S Ninian's, Whithorn"/>
  <tag k="type" v="route"/>
  <tag k="via" v="Paisley;Ayr;Girvan;Pinwherry;Barrhill;New Luce;Glenluce;website"/>
  <tag k="website" v="https://britishpilgrimage.org/portfolio/whithorn-way/"/>
 </relation>
