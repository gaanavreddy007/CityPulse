  <tag k="description" v="affixed to floor on crossing tactile paving"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="THIS PLAQUE MARKS THE HISTORICAL LOCATION OF THE PAISLEY ROAD TOLL GATE POST. THE TOLL GATE OPERATED FROM 1780 UNTIL 1830 WHEN TOLLS WERE ABOLISHED."/>
  <tag k="inscription:2" v="THE TOLL GATE POST WAS REMOVED FROM THIS LOCATION AND RE-ERECTED A SHORT DISTANCE AWAY WITHIN THE WORKSPACE HOUSING SITE ON 17th FEBRUARY 1988"/>
  <tag k="material" v="metal"/>
  <tag k="memorial" v="plaque"/>
  <tag k="start_date" v="1988-02-17"/>
 </node>
