# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Testing & Linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Large raw datasets & archives (preserved locally; not tracked in future git stages)
data/raw/*.zip
data/raw/*.tar.gz
data/raw/*.parquet

# Local logs & temporary output
*.log
scratch/
